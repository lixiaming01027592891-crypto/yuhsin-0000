                <path d="M36 16L44 22V36H38" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
                <path d="M8 16V10C8 8.9 8.9 8 10 8H22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
