                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5-4.771c0 .345-.285.63-.631.63-.348 0-.629-.285-.629-.63V8.108c0-.345.281-.63.629-.63.346 0 .631.285.631.63v4.771zm-2.466.062c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629v-1.09H5.278v1.09c0 .344-.282.629-.631.629-.345 0-.626-.285-.626-.629V8.108c0-.345.281-.63.626-.63.349 0 .631.285.631.63v1.09h1.412v-1.09c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm10.188 7.68c-2.617-2.617-6.876-2.617-9.493 0-.22.219-.513.326-.806.326s-.586-.107-.806-.326c-.445-.445-.445-1.168 0-1.613 3.506-3.506 9.406-3.506 12.911 0 .445.445.445 1.168 0 1.613-.44.445-1.167.445-1.611 0h.801z"/></svg>
