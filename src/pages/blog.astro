---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

const posts = allPosts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .map(post => ({
    slug: post.slug,
    title: post.data.title,
    date: post.data.pubDate.toISOString().split('T')[0],
    category: post.data.category,
    excerpt: post.data.description,
  }));

const categoryMap: Record<string, string> = {
  '搬家知識': '搬家知識',
  '費用指南': '費用指南',
  '選擇指南': '選擇指南',
  '寄倉服務': '寄倉服務',
  '打包技巧': '打包技巧',
  '公司搬遷': '公司搬遷',
  'move': '搬家服務',
  'home-moving': '住家搬家',
  'office-moving': '公司搬遷',
  'special-moving': '專項服務',
  'moving-guide': '搬家指南',
  'recommend': '推薦',
  'qna': '問答',
};

const allCategories = ['全部', ...new Set(posts.map(p => categoryMap[p.category] || p.category))];
---

<Layout title="部落格" description="煜欣搬家部落格，提供搬家知識、實用技巧、行業資訊，讓您的搬家過程更輕鬆順利。">
  <!-- Banner -->
  <section class="page-banner">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/5 rounded-full translate-y-1/3 -translate-x-1/4"></div>
    <svg class="absolute top-10 left-10 w-16 h-16 text-white/10" viewBox="0 0 64 64" fill="none">
      <path d="M10 32c0-12 10-22 22-22s22 10 22 22" stroke="white" stroke-width="2" stroke-linecap="round"/>
      <circle cx="20" cy="20" r="3" fill="white" fill-opacity="0.3"/>
    </svg>
    <svg class="absolute top-20 right-32 w-12 h-12 text-accent/20" viewBox="0 0 48 48" fill="none">
      <path d="M24 4l5 15h15l-12 9 5 15-13-9-13 9 5-15-12-9h15z" stroke="#F5A623" stroke-width="2" stroke-linejoin="round"/>
    </svg>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-sm text-primary-200 mb-2">
        <a href="/" class="hover:text-accent transition-colors">首頁</a>
        <span class="mx-2">/</span>
        <span class="text-white">部落格</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold text-white">部落格</h1>
      <p class="text-primary-100 mt-3 text-lg">搬家知識、實用技巧、行業資訊</p>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" class="w-full" preserveAspectRatio="none">
        <path d="M0 80V40C240 80 480 0 720 20C960 40 1200 0 1440 40V80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Blog Grid -->
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- 分類標籤 -->
      <div class="flex flex-wrap justify-center gap-3 mb-12">
        {allCategories.map((cat, idx) => (
          <button class={`px-5 py-2 rounded-full text-sm font-medium transition-all duration-300 ${idx === 0 ? 'bg-primary text-white shadow-md' : 'bg-white text-gray-600 border border-gray-200 hover:border-primary hover:text-primary'}`}>
            {cat}
          </button>
        ))}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}/`} class={`group bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden card-hover animate-on-scroll delay-${(i % 3 + 1) * 100}`}>
            <div class="h-48 flex items-center justify-center relative overflow-hidden bg-gradient-to-br from-primary to-primary-400">
              <div class="absolute top-4 left-4">
                <span class="bg-accent text-white text-xs px-3 py-1 rounded-full font-medium">{post.category}</span>
              </div>
              <svg class="w-20 h-20 text-white/20" viewBox="0 0 80 80" fill="none">
                <rect x="15" y="25" width="35" height="40" rx="4" stroke="white" stroke-width="2" stroke-linecap="round"/>
                <path d="M25 40h20M25 50h15" stroke="white" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
                <circle cx="55" cy="50" r="12" stroke="white" stroke-width="2" fill="none" opacity="0.3"/>
                <path d="M50 50l4 4 8-8" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="p-6">
              <div class="text-sm text-gray-400 mb-2">{post.date}</div>
              <h3 class="text-lg font-bold text-primary mb-2 group-hover:text-accent transition-colors line-clamp-2">{post.title}</h3>
              <p class="text-gray-500 text-sm line-clamp-2">{post.excerpt}</p>
              <div class="mt-4 flex items-center text-accent text-sm font-medium">
                閱讀更多
                <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 lg:py-20 bg-gradient-to-br from-primary to-primary-500 relative overflow-hidden">
    <svg class="absolute top-0 left-0 w-32 h-32 text-white/5" viewBox="0 0 128 128" fill="none">
      <circle cx="64" cy="64" r="50" stroke="white" stroke-width="2" stroke-dasharray="6 4"/>
    </svg>
    <svg class="absolute bottom-0 right-0 w-40 h-40 text-white/5" viewBox="0 0 160 160" fill="none">
      <path d="M80 10l20 60h60l-50 35 20 60-50-35-50 35 20-60-50-35h60z" stroke="white" stroke-width="2" stroke-linejoin="round"/>
    </svg>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <h2 class="text-2xl lg:text-4xl font-bold text-white mb-4">需要專業搬家服務？</h2>
      <p class="text-primary-100 mb-8 text-lg">煜欣搬家提供全省服務，免費到府估價，秉持信用、服務用心、專業快速</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:0983743969" class="btn-accent">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          立即預約 0983-743969
        </a>
        <a href="/contact/" class="btn-outline">聯絡我們</a>
      </div>
    </div>
  </section>
</Layout>
