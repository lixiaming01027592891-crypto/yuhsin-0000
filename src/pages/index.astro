---
import Layout from '../layouts/Layout.astro';

const services = [
  { name: '日式搬家', desc: '免動手打包，全程專業服務', icon: 'box' },
  { name: '全省搬運', desc: '服務範圍涵蓋全省各地', icon: 'truck' },
  { name: '公司搬遷', desc: '企業搬遷快速高效', icon: 'building' },
  { name: '廢棄物處理', desc: '妥善處理搬家後廢棄物', icon: 'trash' },
  { name: '吊車搬運', desc: '大型物品專業吊運', icon: 'crane' },
  { name: '寄倉服務', desc: '安全可靠的物品寄存', icon: 'warehouse' },
];

const steps = [
  { num: '01', title: '電話諮詢', desc: '初步了解搬遷時間、地點、需求' },
  { num: '02', title: '現場估價', desc: '專業人員免費到府勘查估價' },
  { num: '03', title: '簽訂合約', desc: '明確記載細節，絕不加價' },
  { num: '04', title: '定位搬遷', desc: '專業團隊分類包裝搬運' },
  { num: '05', title: '完成確認', desc: '確認家具狀況，滿意為止' },
  { num: '06', title: '滿意度調查', desc: '持續改進服務品質' },
];

const features = [
  { title: '免費到府估價', desc: '專業人員免費現場勘查，給您最準確的報價', icon: 'clock' },
  { title: '合約保障', desc: '簽訂服務合約，絕不臨時加價，保障雙方權益', icon: 'shield' },
  { title: '全省服務', desc: '服務範圍涵蓋全省各地，隨時為您服務', icon: 'map' },
  { title: '專業團隊', desc: '經驗豐富的搬運團隊，細心搬運每件物品', icon: 'users' },
];
---

<Layout title="首頁" description="煜欣搬家提供全方位專業搬運服務，全省搬運、公司搬遷、廢棄物處理，免費到府估價0983-743969">
  <!-- Hero Section -->
  <section class="relative min-h-[calc(100vh-5rem)] bg-gradient-to-br from-primary to-primary-500 flex items-center overflow-hidden">
    <!-- Decorative circles -->
    <div class="absolute top-20 right-10 w-64 h-64 bg-white/5 rounded-full animate-float delay-100"></div>
    <div class="absolute bottom-20 left-10 w-48 h-48 bg-accent/10 rounded-full animate-float delay-300"></div>
    <div class="absolute top-1/2 right-1/4 w-24 h-24 bg-white/5 rounded-full animate-float"></div>
    
    <!-- Wave bottom -->
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
        <path d="M0 120L60 105C120 90 240 60 360 45C480 30 600 30 720 37.5C840 45 960 60 1080 67.5C1200 75 1320 75 1380 75L1440 75V120H1380C1320 120 1200 120 1080 120C960 120 840 120 720 120C600 120 480 120 360 120C240 120 120 120 60 120H0Z" fill="#F8F9FA"/>
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-16 lg:py-0 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <!-- Left: Text -->
        <div class="text-white animate-fade-up">
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-full mb-6">
            <span class="w-2 h-2 bg-accent rounded-full animate-pulse"></span>
            <span class="text-sm font-medium">全省服務 · 免費到府估價</span>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4">
            讓搬家<br/>
            <span class="text-accent">變得更輕鬆</span>
          </h1>
          <p class="text-lg sm:text-xl text-primary-100 mb-8 max-w-lg leading-relaxed">
            煜欣搬家提供全方位專業搬運服務，無論是家庭搬遷還是工廠遷移，我們都能精準、安全地完成。
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="tel:0983743969" class="btn-accent">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              0983-743969
            </a>
            <a href="/services.html" class="btn-outline">了解服務</a>
          </div>
          <div class="flex items-center gap-6 mt-10 text-sm text-primary-200">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>24小時服務</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>免費估價</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              <span>合約保障</span>
            </div>
          </div>
        </div>

        <div class="hidden lg:flex justify-center animate-float">
          <img src="/images/hero-moving.jpg" alt="煜欣搬家 - 專業搬家團隊協助家庭搬遷" class="w-full max-w-md rounded-2xl shadow-2xl" loading="eager" />
        </div>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 rounded-2xl overflow-hidden shadow-lg animate-on-scroll">
        <img src="/images/home-services.jpg" alt="煜欣搬家多元化服務：打包、吊車、辦公室搬遷、倉儲" class="w-full" loading="lazy" />
      </div>
      <div class="text-center mb-12 lg:mb-16">
        <span class="inline-block bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium mb-4">OUR SERVICES</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-4">我們的服務</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">專業提供全方位搬運服務，滿足您的各種需求</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {services.map((s, i) => (
          <a href="/services.html" class="group bg-white rounded-2xl p-8 shadow-sm border border-gray-100 card-hover animate-on-scroll delay-{i*100}">
            <div class="service-icon-circle mb-5">
              {s.icon === 'box' && (
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
              )}
              {s.icon === 'truck' && (
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
                  <path d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/>
                </svg>
              )}
              {s.icon === 'building' && (
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
              )}
              {s.icon === 'trash' && (
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              )}
              {s.icon === 'crane' && (
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20h16M6 20V10l6-4 6 4v10M12 6v14"/>
                  <circle cx="12" cy="6" r="2"/>
                </svg>
              )}
              {s.icon === 'warehouse' && (
                <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 21h18M5 21V7l8-4 8 4v14M9 21v-6h6v6"/>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold text-primary mb-2 group-hover:text-accent transition-colors">{s.name}</h3>
            <p class="text-gray-500 text-sm">{s.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Overview -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-4xl mx-auto rounded-2xl overflow-hidden shadow-lg animate-on-scroll">
        <img src="/images/home-process.jpg" alt="煜欣搬家六大標準流程：從諮詢到滿意度調查" class="w-full" loading="lazy" />
      </div>
      <div class="text-center mb-12 lg:mb-16">
        <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full text-sm font-medium mb-4">PROCESS</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-4">搬家流程</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">六大步驟，讓您安心無憂</p>
      </div>
      <div class="relative">
        <!-- Connecting line (desktop) -->
        <div class="hidden lg:block absolute top-8 left-0 right-0 h-0.5 bg-primary-100"></div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 lg:gap-4">
          {steps.map((step, i) => (
            <div class="text-center animate-on-scroll delay-{i*100} relative z-10">
              <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-accent text-white font-bold text-lg mb-4 shadow-lg">
                {step.num}
              </div>
              <h3 class="text-lg font-bold text-primary mb-2">{step.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="text-center mt-10">
        <a href="/process.html" class="btn-primary">查看詳細流程</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10 max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-lg animate-on-scroll">
        <img src="/images/home-features.jpg" alt="煜欣搬家四大優勢：免費估價、合約保障、全省服務、專業團隊" class="w-full" loading="lazy" />
      </div>
      <div class="text-center mb-12 lg:mb-16">
        <span class="inline-block bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium mb-4">WHY US</span>
        <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-4">選擇煜欣搬家的理由</h2>
        <p class="text-gray-500 max-w-2xl mx-auto">我們用心服務每一位客戶，讓您的搬家體驗更輕鬆</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {features.map((f, i) => (
          <div class="bg-white rounded-2xl p-6 text-center shadow-sm border border-gray-100 card-hover animate-on-scroll delay-{i*100}">
            <div class="w-16 h-16 rounded-full bg-primary-50 flex items-center justify-center mx-auto mb-4 text-primary">
              {f.icon === 'clock' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                </svg>
              )}
              {f.icon === 'shield' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              )}
              {f.icon === 'map' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              )}
              {f.icon === 'users' && (
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              )}
            </div>
            <h3 class="text-lg font-bold text-primary mb-2">{f.title}</h3>
            <p class="text-gray-500 text-sm">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="relative bg-primary py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-56 h-56 bg-accent/10 rounded-full translate-y-1/3 -translate-x-1/4"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-10 items-center">
        <div class="text-white">
          <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">準備好搬家了嗎？</h2>
          <p class="text-primary-100 text-lg mb-8">立即聯繫我們，免費到府估價，讓搬家變得更輕鬆！</p>
          <div class="flex flex-wrap gap-4">
            <a href="tel:0983743969" class="btn-accent">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              立即預約
            </a>
            <a href="/contact.html" class="btn-outline">了解更多</a>
          </div>
        </div>
        <div class="hidden lg:flex justify-center animate-float">
          <img src="/images/home-cta.jpg" alt="立即預約煜欣搬家服務" class="w-full max-w-md rounded-2xl shadow-xl" loading="lazy" />
        </div>
      </div>
    </div>
  </section>
</Layout>
