---
import Layout from '../layouts/Layout.astro';

const contactInfo = [
  { label: '預約電話', value: '0983-743969', sub: '全天候服務', href: 'tel:0983743969', icon: 'phone' },
  { label: 'LINE 預約', value: '0983743969', sub: '線上即時諮詢', href: 'https://line.me/ti/p/~0983743969', icon: 'line' },
  { label: '電子郵件', value: 'a0983743969@gmail.com', sub: '', href: 'mailto:a0983743969@gmail.com', icon: 'email' },
  { label: '公司地址', value: '台南市安南區安和路二段30號', sub: '', href: 'https://maps.google.com/?q=台南市安南區安和路二段30號', icon: 'map' },
];
---

<Layout title="聯絡我們" description="聯絡煜欣搬家，全省服務免費到府估價，電話0983-743969 LINE 0983743969">
  <section class="page-banner">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/10 rounded-full translate-y-1/2 -translate-x-1/4"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-sm text-primary-200 mb-2">
        <a href="/" class="hover:text-accent transition-colors">首頁</a>
        <span class="mx-2">/</span>
        <span class="text-white">聯絡我們</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold text-white">聯絡我們</h1>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" class="w-full">
        <path d="M0 80V40C240 80 480 0 720 20C960 40 1200 0 1440 40V80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Contact Info & Form -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
        <!-- Left: Contact Info -->
        <div class="lg:col-span-2 animate-on-scroll">
          <span class="inline-block bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium mb-4">CONTACT</span>
          <h2 class="text-2xl lg:text-3xl font-bold text-primary mb-6">聯絡資訊</h2>
          <p class="text-gray-500 mb-8">有任何問題歡迎您致電或加 LINE 詢問，我們將竭誠為您服務！</p>
          
          <div class="space-y-5">
            {contactInfo.map(info => (
              <a href={info.href} target={info.href.startsWith('http') ? '_blank' : undefined} rel={info.href.startsWith('http') ? 'noopener' : undefined} class="flex items-start gap-4 p-4 rounded-xl bg-surface hover:bg-primary-50 transition-colors group">
                <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white flex-shrink-0 group-hover:bg-accent transition-colors">
                  {info.icon === 'phone' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                  )}
                  {info.icon === 'line' && (
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5-4.771c0 .345-.285.63-.631.63-.348 0-.629-.285-.629-.63V8.108c0-.345.281-.63.629-.63.346 0 .631.285.631.63v4.771zm-2.466.062c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629v-1.09H5.278v1.09c0 .344-.282.629-.631.629-.345 0-.626-.285-.626-.629V8.108c0-.345.281-.63.626-.63.349 0 .631.285.631.63v1.09h1.412v-1.09c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm10.188 7.68c-2.617-2.617-6.876-2.617-9.493 0-.22.219-.513.326-.806.326s-.586-.107-.806-.326c-.445-.445-.445-1.168 0-1.613 3.506-3.506 9.406-3.506 12.911 0 .445.445.445 1.168 0 1.613-.44.445-1.167.445-1.611 0h.801z"/>
                    </svg>
                  )}
                  {info.icon === 'email' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  )}
                  {info.icon === 'map' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  )}
                </div>
                <div>
                  <p class="text-sm text-gray-400">{info.label}</p>
                  <p class="font-semibold text-primary">{info.value}</p>
                  {info.sub && <p class="text-xs text-gray-400">{info.sub}</p>}
                </div>
              </a>
            ))}
          </div>

          <!-- Social buttons -->
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="https://www.facebook.com/jake43215yahoo.com.tw/" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#1877F2] text-white rounded-full text-sm font-medium hover:bg-[#166fe5] transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
              Facebook 專頁
            </a>
            <a href="https://line.me/ti/p/~0983743969" target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#06C755] text-white rounded-full text-sm font-medium hover:bg-[#05b34d] transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755z"/>
              </svg>
              LINE 諮詢
            </a>
          </div>
        </div>

        <!-- Right: Form -->
        <div class="lg:col-span-3 animate-on-scroll delay-200">
          <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-sm border border-gray-100">
            <h3 class="text-2xl font-bold text-primary mb-2">線上諮詢</h3>
            <p class="text-gray-500 text-sm mb-6">填寫以下表單，我們將盡快與您聯繫</p>
            <form action="mailto:a0983743969@gmail.com" method="post" enctype="text/plain" class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1.5">姓名 <span class="text-red-400">*</span></label>
                  <input type="text" name="姓名" required class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="您的姓名" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1.5">聯絡電話 <span class="text-red-400">*</span></label>
                  <input type="tel" name="電話" required class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="0987-654-321" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                <input type="email" name="Email" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="example@email.com" />
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1.5">搬家日期</label>
                  <input type="date" name="搬家日期" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1.5">服務類型</label>
                  <select name="服務類型" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm bg-white">
                    <option value="">請選擇</option>
                    <option value="家庭搬家">家庭搬家</option>
                    <option value="公司搬遷">公司搬遷</option>
                    <option value="廢棄物處理">廢棄物處理</option>
                    <option value="吊車搬運">吊車搬運</option>
                    <option value="其他">其他</option>
                  </select>
                </div>
              </div>
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1.5">搬出地址</label>
                  <input type="text" name="搬出地址" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="搬出地址" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1.5">搬入地址</label>
                  <input type="text" name="搬入地址" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm" placeholder="搬入地址" />
                </div>
              </div>
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1.5">訊息內容</label>
                <textarea name="訊息" rows="4" class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all text-sm resize-none" placeholder="請描述您的需求..."></textarea>
              </div>
              <button type="submit" class="w-full btn-accent py-3">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                </svg>
                送出諮詢
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Area -->
  <section class="bg-surface py-16 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="animate-on-scroll">
        <svg class="w-16 h-16 text-primary mx-auto mb-6" viewBox="0 0 64 64" fill="none">
          <circle cx="32" cy="32" r="28" fill="#1B4B7A" opacity="0.05"/>
          <circle cx="32" cy="32" r="24" fill="none" stroke="#1B4B7A" stroke-width="1.5" opacity="0.2"/>
          <path d="M32 10v6M32 48v6M10 32h6M48 32h6" stroke="#1B4B7A" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
          <circle cx="32" cy="32" r="10" fill="none" stroke="#1B4B7A" stroke-width="1.5"/>
          <circle cx="32" cy="32" r="4" fill="#F5A623" opacity="0.5"/>
          <path d="M26 20c2-2 4-3 6-3s4 1 6 3" stroke="#1B4B7A" stroke-width="1.2" stroke-linecap="round" opacity="0.4"/>
        </svg>
        <h2 class="text-2xl lg:text-3xl font-bold text-primary mb-4">服務區域</h2>
        <p class="text-gray-500 max-w-2xl mx-auto mb-6">全省服務，免費到府估價。無論您在台灣哪個角落，煜欣搬家都能為您提供專業的搬運服務。</p>
        <div class="flex flex-wrap justify-center gap-2 max-w-3xl mx-auto">
          {['台北市','新北市','桃園市','台中市','台南市','高雄市','基隆市','新竹市','嘉義市','宜蘭縣','新竹縣','彰化縣','南投縣','雲林縣','嘉義縣','屏東縣','花蓮縣','台東縣'].map(city => (
            <span class="px-3 py-1 bg-white rounded-full text-sm text-gray-600 border border-gray-100">{city}</span>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
