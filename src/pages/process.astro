---
import Layout from '../layouts/Layout.astro';

const steps = [
  { num: '01', title: '電話諮詢', desc: '接獲客戶來電或線上詢問後做電話諮詢，初步了解搬遷時間、地點、家具項目、數量及包裝需求！', icon: 'phone' },
  { num: '02', title: '現場估價', desc: '由最專業的人員親自到府做免費的現場勘查及估價服務，並提供搬遷建議及需要注意的事項說明。', icon: 'estimate' },
  { num: '03', title: '簽訂合約', desc: '雙方達成共識後，簽訂服務合約書，明確記載搬遷時間、地點、家具數量、搬運費用、損壞理賠等，絕不隨意加價。', icon: 'contract' },
  { num: '04', title: '定位搬遷', desc: '依照事前談妥之指定時間，派出最專業的搬家團隊到達遷出地點，將家具依類型做適當分類包裝，依序上車運送，抵達入厝地點後，再依客戶指定位置擺設歸位。', icon: 'move' },
  { num: '05', title: '作業完成確認', desc: '完成搬遷服務後，確認家具有無因搬遷過程造成意外的損傷。若有損壞，則依事前協定進行理賠事宜。', icon: 'check' },
  { num: '06', title: '滿意度調查', desc: '客戶的指教是我們進步的原動力。每一次完成搬家服務後，詢問客戶意見及需要改進的事項，以作為下次精進公司服務的依據。', icon: 'survey' },
];

const tips = [
  { title: '裝箱打包', items: ['裝箱時請勿將紙箱裝得過重或過滿','衣櫃/斗櫃/書桌/酒櫃及抽屜中的物品請務必清空','易碎物品做好隔離防護並在箱子上清楚標示','貴重物品請自行妥善保管'] },
  { title: '搬運時', items: ['搬運開始前與搬運方再次核對物品清單及費用','搬運前後確認車廂是否清空','到達搬家地點後明確指示每件物品的擺放位置','搬運人員進出產生的音量請提前與鄰居打招呼'] },
  { title: '點收時', items: ['協助服務人員將大型家具及家電定位並組裝到位','仔細檢查所有物品是否已運送完畢','若發現家具有任何破損請立即通知現場工作人員','確認完成後簽署滿意度調查表'] },
];
---

<Layout title="搬家流程" description="煜欣搬家六大標準作業流程，從電話諮詢到滿意度調查，讓您安心無憂搬家">
  <section class="page-banner">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/10 rounded-full translate-y-1/2 -translate-x-1/4"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-sm text-primary-200 mb-2">
        <a href="/" class="hover:text-accent transition-colors">首頁</a>
        <span class="mx-2">/</span>
        <span class="text-white">搬家流程</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold text-white">搬家流程</h1>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" class="w-full">
        <path d="M0 80V40C240 80 480 0 720 20C960 40 1200 0 1440 40V80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Process Steps -->
  <section class="py-16 lg:py-24">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 lg:mb-16">
        <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full text-sm font-medium mb-4">6 STEPS</span>
        <h2 class="text-3xl font-bold text-primary mb-4">服務流程</h2>
        <p class="text-gray-500">六大步驟，讓您安心無憂</p>
      </div>
      <div class="relative">
        <!-- Timeline line -->
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-0.5 bg-primary-100 -translate-x-1/2"></div>
        <div class="space-y-8 lg:space-y-12">
          {steps.map((step, i) => (
            <div class={`relative grid md:grid-cols-2 gap-6 md:gap-12 items-center animate-on-scroll ${i % 2 === 0 ? '' : 'md:direction-rtl'}`}>
              {/* Center dot */}
              <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-10">
                <div class="w-10 h-10 rounded-full bg-accent text-white font-bold text-sm flex items-center justify-center shadow-lg border-4 border-white">
                  {step.num}
                </div>
              </div>
              {/* Content */}
              <div class={`${i % 2 === 0 ? 'md:text-right md:pr-12' : 'md:order-2 md:text-left md:pl-12'}`}>
                <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-sm border border-gray-100">
                  <div class="md:hidden w-10 h-10 rounded-full bg-accent text-white font-bold flex items-center justify-center mb-4">
                    {step.num}
                  </div>
                  <h3 class="text-xl font-bold text-primary mb-3">{step.title}</h3>
                  <p class="text-gray-500 leading-relaxed">{step.desc}</p>
                </div>
              </div>
              <div class={`${i % 2 === 0 ? 'md:order-2 md:pl-12' : 'md:order-1 md:pr-12'}`}>
                <div class="flex justify-center">
                  <svg viewBox="0 0 120 120" class="w-28 h-28" fill="none">
                    <circle cx="60" cy="60" r="50" fill="#1B4B7A" opacity="0.05"/>
                    <circle cx="60" cy="60" r="45" fill="none" stroke="#1B4B7A" stroke-width="1.5" opacity="0.15"/>
                    {step.icon === 'phone' && (
                      <g stroke="#1B4B7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M55 45c0 0-4 0-4 4v6c0 0 0 4 4 4" fill="none"/>
                        <path d="M65 45c0 0 4 0 4 4v6c0 0 0 4-4 4" fill="none"/>
                        <path d="M50 55h20M55 48v14M65 48v14" fill="none"/>
                        <path d="M48 68c-4-6 2-12 8-12h8c6 0 12 6 8 12" fill="none"/>
                        <path d="M48 68v8" stroke-width="1.5"/>
                        <path d="M72 68v8" stroke-width="1.5"/>
                        <path d="M44 50l-4-3c-2-1-2-4 0-5" stroke-width="1.5"/>
                        <path d="M76 50l4-3c2-1 2-4 0-5" stroke-width="1.5"/>
                        <ellipse cx="52" cy="78" rx="5" ry="2.5" fill="none" stroke-width="1.5"/>
                        <ellipse cx="68" cy="78" rx="5" ry="2.5" fill="none" stroke-width="1.5"/>
                      </g>
                    )}
                    {step.icon === 'estimate' && (
                      <g stroke="#1B4B7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="38" y="32" width="44" height="56" rx="5" fill="none"/>
                        <path d="M48 48h24M48 58h18M48 68h20" stroke-width="1.5"/>
                        <circle cx="53" cy="48" r="2" fill="#F5A623"/>
                        <path d="M50 38l3-3 3 3" stroke-width="1.5"/>
                      </g>
                    )}
                    {step.icon === 'contract' && (
                      <g stroke="#1B4B7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="38" y="28" width="44" height="56" rx="5" fill="none"/>
                        <path d="M48 44h24M48 54h24M48 64h16" stroke-width="1.5"/>
                        <path d="M54 76l4 4 8-8" stroke-width="2"/>
                        <circle cx="72" cy="50" r="8" fill="#F5A623" opacity="0.3"/>
                      </g>
                    )}
                    {step.icon === 'move' && (
                      <g stroke="#1B4B7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="32" y="55" width="40" height="28" rx="5" fill="none"/>
                        <circle cx="42" cy="88" r="6" fill="none"/>
                        <circle cx="62" cy="88" r="6" fill="none"/>
                        <rect x="72" y="45" width="16" height="24" rx="3" fill="#F5A623" opacity="0.3"/>
                        <path d="M76 55h8M80 51v8" stroke-width="1.5"/>
                        <path d="M55 38v-8l6-6" stroke-width="1.5"/>
                        <circle cx="55" cy="40" r="4" fill="#F5A623" opacity="0.4"/>
                      </g>
                    )}
                    {step.icon === 'check' && (
                      <g stroke="#1B4B7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="60" cy="60" r="30" fill="#1B4B7A" opacity="0.05"/>
                        <circle cx="60" cy="60" r="25" fill="none"/>
                        <path d="M50 60l6 6 14-14" stroke-width="2.5"/>
                        <path d="M60 28v4M60 88v4M28 60h4M88 60h4" stroke-width="1.5" opacity="0.3"/>
                      </g>
                    )}
                    {step.icon === 'survey' && (
                      <g stroke="#1B4B7A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="40" y="30" width="40" height="52" rx="5" fill="none"/>
                        <path d="M50 46h20M50 55h20M50 64h14" stroke-width="1.5"/>
                        <circle cx="75" cy="55" r="6" fill="none" stroke-width="1.5"/>
                        <path d="M73 55l1.5 1.5 3.5-3.5" stroke-width="1.5"/>
                        <path d="M56 42c0 0 2-2 4-1" stroke-width="1.2"/>
                        <path d="M46 75c4 0 8 2 10 5" stroke-width="1.5" opacity="0.4"/>
                      </g>
                    )}
                  </svg>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Moving Tips -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span class="inline-block bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium mb-4">TIPS</span>
        <h2 class="text-3xl font-bold text-primary mb-4">搬家注意事項</h2>
        <p class="text-gray-500">掌握這些小訣竅，讓搬家更順利</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        {tips.map((t, i) => (
          <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-sm border border-gray-100 animate-on-scroll delay-{i*100}">
            <div class="w-14 h-14 rounded-full bg-primary-50 flex items-center justify-center mb-5 text-primary">
              {i === 0 && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
              )}
              {i === 1 && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              )}
              {i === 2 && (
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold text-primary mb-4">{t.title}</h3>
            <ul class="space-y-3">
              {t.items.map(item => (
                <li class="flex items-start gap-3 text-gray-600 text-sm">
                  <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
