---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';

export function getStaticPaths() {
  return Object.keys(posts).map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = posts[slug];

if (!post) {
  return Astro.redirect('/404');
}

const otherSlugs = Object.keys(posts).filter(k => k !== slug).slice(0, 3);
---

<Layout title={post.title} description={`${post.excerpt} | 煜欣搬家部落格`}>
  <!-- Banner -->
  <section class="page-banner">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-sm text-primary-200 mb-2">
        <a href="/" class="hover:text-accent transition-colors">首頁</a>
        <span class="mx-2">/</span>
        <a href="/blog.html" class="hover:text-accent transition-colors">部落格</a>
        <span class="mx-2">/</span>
        <span class="text-white">{post.category}</span>
      </div>
      <h1 class="text-2xl lg:text-4xl font-bold text-white max-w-3xl">{post.title}</h1>
      <div class="flex flex-wrap items-center gap-4 mt-4 text-primary-100 text-sm">
        <span class="bg-accent/20 px-3 py-1 rounded-full">{post.category}</span>
        <span>{post.date}</span>
        <span>閱讀時間 {post.readTime}</span>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" class="w-full">
        <path d="M0 80V40C240 80 480 0 720 20C960 40 1200 0 1440 40V80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Article Content -->
  <article class="py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Illustration -->
      <div class="flex justify-center mb-10">
        <svg viewBox="0 0 200 160" class="w-48 opacity-60" fill="none">
          <rect x="30" y="50" width="100" height="80" rx="8" stroke="#1B4B7A" stroke-width="2" fill="#1B4B7A" fill-opacity="0.05" stroke-linecap="round"/>
          <path d="M45 75h70M45 90h50M45 105h60" stroke="#1B4B7A" stroke-width="1.5" stroke-linecap="round" opacity="0.3"/>
          <circle cx="140" cy="100" r="25" stroke="#1B4B7A" stroke-width="2" fill="none" opacity="0.15"/>
          <path d="M130 95l8 8 16-16" stroke="#F5A623" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="60" cy="30" r="8" fill="#F5A623" opacity="0.25"/>
          <circle cx="160" cy="45" r="6" fill="#F5A623" opacity="0.2"/>
        </svg>
      </div>
      
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed" set:html={post.content} />
      
      <!-- CTA -->
      <div class="mt-12 bg-gradient-to-br from-primary to-primary-500 rounded-2xl p-8 text-white text-center">
        <h3 class="text-xl font-bold text-white mb-3">需要搬家服務？</h3>
        <p class="text-primary-100 mb-6">煜欣搬家提供專業搬運服務，免費到府估價</p>
        <a href="tel:0983743969" class="btn-accent">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          立即預約 0983-743969
        </a>
      </div>
      
      <!-- Recommended Posts -->
      {otherSlugs.length > 0 && (
        <div class="mt-16">
          <h3 class="text-xl font-bold text-primary mb-6">推薦閱讀</h3>
          <div class="space-y-4">
            {otherSlugs.map(s => (
              <a href={`/blog/${s}.html`} class="flex items-start gap-4 p-4 rounded-xl bg-surface hover:bg-primary-50 transition-colors group">
                <div class="w-12 h-12 rounded-full bg-primary-50 flex items-center justify-center text-primary flex-shrink-0 group-hover:bg-primary group-hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                  </svg>
                </div>
                <div>
                  <span class="text-xs text-accent font-medium">{posts[s].category}</span>
                  <h4 class="font-semibold text-primary group-hover:text-accent transition-colors">{posts[s].title}</h4>
                  <span class="text-sm text-gray-400">{posts[s].date}</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
      
      <!-- Back to blog -->
      <div class="mt-10 text-center">
        <a href="/blog.html" class="inline-flex items-center text-primary hover:text-accent transition-colors font-medium">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          回到部落格
        </a>
      </div>
    </div>
  </article>
</Layout>
