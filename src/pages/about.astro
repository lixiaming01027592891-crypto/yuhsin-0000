---
import Layout from '../layouts/Layout.astro';

const values = [
  { title: '秉持信用', desc: '以誠信為本，對每一位客戶負責，建立長期信賴關係', icon: 'handshake' },
  { title: '服務用心', desc: '細心聆聽客戶需求，提供貼心周到的搬家服務體驗', icon: 'heart' },
  { title: '專業快速', desc: '經驗豐富的專業團隊，高效完成每一次搬運任務', icon: 'zap' },
];
---

<Layout title="關於我們" description="煜欣搬家公司介紹，專業提供日式搬家、全省搬運、廢棄物處理等服務，秉持信用、服務用心、專業快速">
  <!-- Banner -->
  <section class="page-banner">
    <div class="absolute top-0 right-0 w-72 h-72 bg-white/5 rounded-full -translate-y-1/2 translate-x-1/3"></div>
    <div class="absolute bottom-0 left-0 w-48 h-48 bg-accent/10 rounded-full translate-y-1/2 -translate-x-1/4"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-sm text-primary-200 mb-2">
        <a href="/" class="hover:text-accent transition-colors">首頁</a>
        <span class="mx-2">/</span>
        <span class="text-white">關於我們</span>
      </div>
      <h1 class="text-3xl lg:text-5xl font-bold text-white">關於我們</h1>
    </div>
    <div class="absolute bottom-0 left-0 right-0">
      <svg viewBox="0 0 1440 80" fill="none" class="w-full">
        <path d="M0 80V40C240 80 480 0 720 20C960 40 1200 0 1440 40V80H0Z" fill="white"/>
      </svg>
    </div>
  </section>

  <!-- Company Intro -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="animate-on-scroll">
          <span class="inline-block bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium mb-4">ABOUT US</span>
          <h2 class="text-3xl lg:text-4xl font-bold text-primary mb-6">全方位專業搬運<br/>讓搬遷輕鬆無憂</h2>
          <div class="space-y-4 text-gray-600 leading-relaxed">
            <p>煜欣搬家有限公司專業提供全方位搬運服務，無論是小型家庭搬遷還是大型工廠遷移，我們都能精準、安全地完成。</p>
            <p>我們的服務範圍涵蓋全省，不僅提供搬運服務，還包括廢棄物處理、寄倉服務、吊車搬運、自助搬家等多項選擇，滿足客戶的各種需求。</p>
            <p>此外，我們還專業處理公司搬遷、人力派遣、裝潢拆除及家具系統規劃服務，讓您的搬遷過程輕鬆無憂。</p>
            <p class="font-medium text-primary">選擇煜欣搬家，讓我們為您打理搬遷每個細節！</p>
          </div>
          <div class="mt-8">
            <a href="/contact.html" class="btn-primary">聯絡我們</a>
          </div>
        </div>
        <div class="flex justify-center animate-on-scroll delay-200">
          <img src="/images/about-team.jpg" alt="煜欣搬家專業團隊與滿意客戶" class="w-full max-w-md rounded-2xl shadow-xl" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-surface py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary mb-4">服務理念</h2>
        <p class="text-gray-500">我們堅持三大核心價值，為客戶提供最優質的服務</p>
      </div>
      <div class="grid sm:grid-cols-3 gap-8">
        {values.map((v, i) => (
          <div class="bg-white rounded-2xl p-8 text-center shadow-sm border border-gray-100 card-hover animate-on-scroll delay-{i*100}">
            <div class="w-20 h-20 rounded-full bg-primary-50 flex items-center justify-center mx-auto mb-5 text-primary">
              {v.icon === 'handshake' && (
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              )}
              {v.icon === 'heart' && (
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              )}
              {v.icon === 'zap' && (
                <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              )}
            </div>
            <h3 class="text-xl font-bold text-primary mb-3">{v.title}</h3>
            <p class="text-gray-500">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Company Info -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-br from-primary to-primary-500 rounded-3xl p-8 lg:p-12 text-white animate-on-scroll">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-3">
              <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <p class="text-sm text-primary-100">地址</p>
            <p class="font-medium">台南市安南區<br/>安和路二段30號</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-3">
              <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <p class="text-sm text-primary-100">電話</p>
            <p class="font-medium">0983-743969</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-3">
              <svg class="w-7 h-7 text-accent" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755z"/>
              </svg>
            </div>
            <p class="text-sm text-primary-100">LINE</p>
            <p class="font-medium">0983743969</p>
          </div>
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-white/10 flex items-center justify-center mx-auto mb-3">
              <svg class="w-7 h-7 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <p class="text-sm text-primary-100">信箱</p>
            <p class="font-medium text-sm">a0983743969<br/>@gmail.com</p>
          </div>
        </div>
        <div class="text-center mt-10">
          <a href="/contact.html" class="btn-accent">立即聯繫我們</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
